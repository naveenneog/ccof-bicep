# produce CRLF (tests/test_architecture_assets.py). The generators write CRLF on every platform.
docs/diagrams/ccof-network-architecture.drawio text eol=crlf
docs/diagrams/ccof-architecture-overview.svg text eol=crlf
docs/diagrams/ccof-network-architecture.svg text eol=crlf
docs/diagrams/dr-network-architecture.py text eol=crlf
docs/images/dr/dr-active-passive.svg text eol=crlf
docs/images/dr/dr-active-passive.excalidraw text eol=crlf
