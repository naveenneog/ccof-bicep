        <mxCell id="title" value="&lt;div style=&quot;font-size:30px;font-weight:bold;line-height:32px&quot;&gt;Claude Code on Foundry | identity, routing &amp;amp; private-network architecture&lt;/div&gt;&lt;div style=&quot;font-size:19px;line-height:27px&quot;&gt;Integrated baseline and optional wiring • Customer-neutral design • Design / wiring requirements, not live acceptance&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ffffff;dashed=0;dashPattern=8 5;fontFamily=Arial;fontSize=19;fontColor=#101820;align=left;verticalAlign=top;spacingTop=14;spacingLeft=16;spacingRight=12;" vertex="1" parent="1">
