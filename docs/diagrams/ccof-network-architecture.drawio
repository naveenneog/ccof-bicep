        <mxCell id="foundry-next" value="&lt;div style=&quot;font-size:21px;font-weight:bold;line-height:32px&quot;&gt;FOUNDRY ACCOUNT • additional project backend&lt;/div&gt;&lt;div style=&quot;font-size:19px;line-height:27px&quot;&gt;Independent per-account MI grant / model deployments&lt;/div&gt;&lt;div style=&quot;font-size:19px;line-height:27px&quot;&gt;Project backendId maps here, not to account A&lt;/div&gt;&lt;div style=&quot;font-size:19px;line-height:27px&quot;&gt;Public/private per owner • optional caller-VNet PE&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f2fc;strokeColor=#0078d4;dashed=0;dashPattern=8 5;fontFamily=Arial;fontSize=19;fontColor=#101820;align=left;verticalAlign=top;spacingTop=14;spacingLeft=16;spacingRight=12;" vertex="1" parent="backend-sub-b">
