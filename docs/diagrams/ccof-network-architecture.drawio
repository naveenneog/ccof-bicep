        <mxCell id="combined" value="&lt;div style=&quot;font-size:21px;font-weight:bold;line-height:32px&quot;&gt;Combined developer + Gateway API&lt;/div&gt;&lt;div style=&quot;font-size:19px;line-height:27px&quot;&gt;Single-tenant public client • token v2&lt;/div&gt;&lt;div style=&quot;font-size:19px;line-height:27px&quot;&gt;Delegated access_as_user • no secret&lt;/div&gt;&lt;div style=&quot;font-size:19px;line-height:27px&quot;&gt;WAM / browser PKCE; device code optional&lt;/div&gt;&lt;div style=&quot;font-size:19px;line-height:27px&quot;&gt;Consent + Conditional Access apply&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f2fc;strokeColor=#0078d4;dashed=0;dashPattern=8 5;fontFamily=Arial;fontSize=19;fontColor=#101820;align=left;verticalAlign=top;spacingTop=14;spacingLeft=16;spacingRight=12;" vertex="1" parent="directory">
          <mxGeometry as="geometry" x="25" y="55" width="440" height="165" />
        </mxCell>
        <mxCell id="groups" value="&lt;div style=&quot;font-size:21px;font-weight:bold;line-height:32px&quot;&gt;Flat Entra security groups → Graph&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:27px&quot;&gt;Direct membership → project / STD / PRM / CYB&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:27px&quot;&gt;Stable group IDs authorize; names are snapshots&lt;/div&gt;&lt;div style=&quot;font-size:19px;line-height:27px&quot;&gt;Sync UAMI: GroupMember.Read.All&lt;/div&gt;&lt;div style=&quot;font-size:19px;line-height:27px&quot;&gt;+ User.Read.All + Application.Read.All&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf5ea;strokeColor=#107c10;dashed=0;dashPattern=8 5;fontFamily=Arial;fontSize=19;fontColor=#101820;align=left;verticalAlign=top;spacingTop=14;spacingLeft=16;spacingRight=12;" vertex="1" parent="directory">
          <mxGeometry as="geometry" x="495" y="55" width="445" height="165" />
        </mxCell>
        <mxCell id="resolver-app" value="&lt;div style=&quot;font-size:21px;font-weight:bold;line-height:32px&quot;&gt;Separate internal Resolver API&lt;/div&gt;&lt;div style=&quot;font-size:19px;line-height:27px&quot;&gt;No public-client redirects / developer scopes&lt;/div&gt;&lt;div style=&quot;font-size:19px;line-height:27px&quot;&gt;EasyAuth pins APIM MI app ID AND object ID&lt;/div&gt;&lt;div style=&quot;font-size:19px;line-height:27px&quot;&gt;APIM-only audience; no developer access&lt;/div&gt;&lt;div style=&quot;font-size:19px;line-height:27px&quot;&gt;Azure Owner ≠ Entra administrator&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f2fc;strokeColor=#0078d4;dashed=0;dashPattern=8 5;fontFamily=Arial;fontSize=19;fontColor=#101820;align=left;verticalAlign=top;spacingTop=14;spacingLeft=16;spacingRight=12;" vertex="1" parent="directory">
          <mxGeometry as="geometry" x="970" y="55" width="455" height="165" />
        </mxCell>
        <mxCell id="workstation" value="&lt;div style=&quot;font-size:21px;font-weight:bold;line-height:32px&quot;&gt;DEVELOPER WORKSTATION&lt;/div&gt;&lt;div style=&quot;font-size:19px;line-height:27px&quot;&gt;Claude Code CLI&lt;/div&gt;&lt;div style=&quot;font-size:19px;line-height:27px&quot;&gt;VS Code Claude Code panel&lt;/div&gt;&lt;div style=&quot;font-size:19px;line-height:27px&quot;&gt;Claude Desktop&lt;/div&gt;&lt;div style=&quot;font-size:19px;line-height:27px&quot;&gt;&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;font-size:19px;line-height:27px&quot;&gt;Approved ccof-token helper&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:27px&quot;&gt;MSAL • secure broker / encrypted cache&lt;/div&gt;&lt;div style=&quot;font-size:19px;line-height:27px&quot;&gt;Gateway API audience only&lt;/div&gt;&lt;div style=&quot;font-size:19px;line-height:27px&quot;&gt;&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:27px&quot;&gt;onboarding.json: strict schemaVersion 1&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:27px&quot;&gt;Config only • no grants / usage metering&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:27px&quot;&gt;No direct Foundry / resolver permission&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f8fc;strokeColor=#0078d4;dashed=0;dashPattern=8 5;fontFamily=Arial;fontSize=19;fontColor=#101820;align=left;verticalAlign=top;spacingTop=14;spacingLeft=16;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="230" width="360" height="480" />
        </mxCell>
        <mxCell id="ingress" value="&lt;div style=&quot;font-size:20px;font-weight:bold;line-height:32px&quot;&gt;OPTIONAL CUSTOMER INGRESS&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:27px&quot;&gt;Internal-only ingress / WAF / SIPA controls&lt;/div&gt;&lt;div style=&quot;font-size:19px;line-height:27px&quot;&gt;Customer-approved access topology&lt;/div&gt;&lt;div style=&quot;font-size:19px;line-height:27px&quot;&gt;Not universally created by quickstart&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:27px&quot;&gt;Dashed = optional, not proof of deployment&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8ed;strokeColor=#ca5010;dashed=1;dashPattern=8 5;fontFamily=Arial;fontSize=19;fontColor=#101820;align=left;verticalAlign=top;spacingTop=14;spacingLeft=16;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="770" width="360" height="195" />
        </mxCell>
        <mxCell id="admin" value="&lt;div style=&quot;font-size:18px;font-weight:bold;line-height:32px&quot;&gt;ADMINISTRATOR CONTROL PLANE&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:27px&quot;&gt;Cloud Shell • ARM / Graph / OneDeploy&lt;/div&gt;&lt;div style=&quot;font-size:19px;line-height:27px&quot;&gt;Resource-specific Bicep modules&lt;/div&gt;&lt;div style=&quot;font-size:19px;line-height:27px&quot;&gt;&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:27px&quot;&gt;Network → resources → directory objects&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:27px&quot;&gt;→ remaining wiring → grants / config / code&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:27px&quot;&gt;→ registrySeed → client artifacts / tests&lt;/div&gt;&lt;div style=&quot;font-size:19px;line-height:27px&quot;&gt;&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;font-size:19px;line-height:27px&quot;&gt;Entra and Azure roles held separately&lt;/div&gt;&lt;div style=&quot;font-size:19px;line-height:27px&quot;&gt;Grant Graph before first timer token&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:27px&quot;&gt;Cached MI tokens can delay new roles&lt;/div&gt;&lt;div style=&quot;font-size:19px;line-height:27px&quot;&gt;&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:27px&quot;&gt;Ordinary Cloud Shell: no private data plane&lt;/div&gt;&lt;div style=&quot;font-size:19px;line-height:27px&quot;&gt;No jumpbox / VM assumption&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8ed;strokeColor=#ca5010;dashed=0;dashPattern=8 5;fontFamily=Arial;fontSize=19;fontColor=#101820;align=left;verticalAlign=top;spacingTop=14;spacingLeft=16;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="1045" width="360" height="420" />
        </mxCell>
        <mxCell id="core" value="&lt;div style=&quot;font-size:18px;font-weight:bold;line-height:32px&quot;&gt;CORE AZURE SUBSCRIPTION • core resource group / approved region&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#687787;dashed=1;dashPattern=8 5;fontFamily=Arial;fontSize=19;fontColor=#101820;align=left;verticalAlign=top;spacingTop=14;spacingLeft=16;spacingRight=12;container=1;collapsible=0;recursiveResize=0;pointerEvents=0;" vertex="1" parent="tenant">
          <mxGeometry as="geometry" x="25" y="335" width="1290" height="1135" />
        </mxCell>
        <mxCell id="apim" value="&lt;div style=&quot;font-size:21px;font-weight:bold;line-height:32px&quot;&gt;AZURE API MANAGEMENT • cloud-managed service&lt;/div&gt;&lt;div style=&quot;font-size:19px;line-height:27px&quot;&gt;Existing APIM usually • system-assigned MI enabled&lt;/div&gt;&lt;div style=&quot;font-size:19px;line-height:27px&quot;&gt;① Validate tenant / audience / client / scope / person&lt;/div&gt;&lt;div style=&quot;font-size:19px;line-height:27px&quot;&gt;x-ccof-project is intent, checked against entitlement&lt;/div&gt;&lt;div style=&quot;font-size:19px;line-height:27px&quot;&gt;Admission cap + cached v3 / d3 resolver decision&lt;/div&gt;&lt;div style=&quot;font-size:19px;line-height:27px&quot;&gt;Exact model admission; aggregate + family ceilings&lt;/div&gt;&lt;div style=&quot;font-size:19px;line-height:27px&quot;&gt;Per-person AND group limits • never substitute backend&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f2fc;strokeColor=#0078d4;dashed=0;dashPattern=8 5;fontFamily=Arial;fontSize=19;fontColor=#101820;align=left;verticalAlign=top;spacingTop=14;spacingLeft=16;spacingRight=12;" vertex="1" parent="core">
          <mxGeometry as="geometry" x="25" y="80" width="565" height="225" />
        </mxCell>
        <mxCell id="resolver" value="&lt;div style=&quot;font-size:21px;font-weight:bold;line-height:32px&quot;&gt;RESOLVER FUNCTION • Flex / system-assigned MI&lt;/div&gt;&lt;div style=&quot;font-size:19px;line-height:27px&quot;&gt;② APIM-only EasyAuth • internal API audience&lt;/div&gt;&lt;div style=&quot;font-size:19px;line-height:27px&quot;&gt;Resolve person + project → classification / backendId&lt;/div&gt;&lt;div style=&quot;font-size:19px;line-height:27px&quot;&gt;Validated familyPolicy: haiku / sonnet / opus&lt;/div&gt;&lt;div style=&quot;font-size:19px;line-height:27px&quot;&gt;Fable / Mythos: exact registration AND CYB only&lt;/div&gt;&lt;div style=&quot;font-size:19px;line-height:27px&quot;&gt;Token-limits-only baseline; optional monetary mode&lt;/div&gt;&lt;div style=&quot;font-size:19px;line-height:27px&quot;&gt;③ Least-privilege Cosmos reads over private SQL PE&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f2fc;strokeColor=#0078d4;dashed=0;dashPattern=8 5;fontFamily=Arial;fontSize=19;fontColor=#101820;align=left;verticalAlign=top;spacingTop=14;spacingLeft=16;spacingRight=12;" vertex="1" parent="core">
          <mxGeometry as="geometry" x="695" y="80" width="565" height="225" />
        </mxCell>
        <mxCell id="sync" value="&lt;div style=&quot;font-size:21px;font-weight:bold;line-height:32px&quot;&gt;SYNC FUNCTION • Flex / user-assigned MI&lt;/div&gt;&lt;div style=&quot;font-size:19px;line-height:27px&quot;&gt;⑤ Microsoft Graph reads → entitlement projection&lt;/div&gt;&lt;div style=&quot;font-size:19px;line-height:27px&quot;&gt;Successful run applies membership additions/removals&lt;/div&gt;&lt;div style=&quot;font-size:19px;line-height:27px&quot;&gt;Freeze affected projects on failed reads; syncLease&lt;/div&gt;&lt;div style=&quot;font-size:19px;line-height:27px&quot;&gt;Conflict: retain incumbent classification, otherwise none&lt;/div&gt;&lt;div style=&quot;font-size:19px;line-height:27px&quot;&gt;registrySeed timer: create-only projects + backends&lt;/div&gt;&lt;div style=&quot;font-size:19px;line-height:27px&quot;&gt;Verify readback; disable timer / clean payload after use&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf5ea;strokeColor=#107c10;dashed=0;dashPattern=8 5;fontFamily=Arial;fontSize=19;fontColor=#101820;align=left;verticalAlign=top;spacingTop=14;spacingLeft=16;spacingRight=12;" vertex="1" parent="core">
          <mxGeometry as="geometry" x="25" y="375" width="565" height="230" />
        </mxCell>
        <mxCell id="cosmos" value="&lt;div style=&quot;font-size:21px;font-weight:bold;line-height:32px&quot;&gt;COSMOS DB • private SQL registry, outside VNet&lt;/div&gt;&lt;div style=&quot;font-size:19px;line-height:27px&quot;&gt;Public access disabled + local auth off at creation&lt;/div&gt;&lt;div style=&quot;font-size:19px;line-height:27px&quot;&gt;entitlement / projects / backends / subscriptionIndex&lt;/div&gt;&lt;div style=&quot;font-size:19px;line-height:27px&quot;&gt;budgetState / aggregateBudgetState&lt;/div&gt;&lt;div style=&quot;font-size:19px;line-height:27px&quot;&gt;syncLease / reconcilerLease&lt;/div&gt;&lt;div style=&quot;font-size:19px;line-height:27px&quot;&gt;Resolver: reads; sync: scoped writes / seed creates&lt;/div&gt;&lt;div style=&quot;font-size:19px;line-height:27px&quot;&gt;Reconciler: scoped budget writes • never broad keys&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f2fc;strokeColor=#0078d4;dashed=0;dashPattern=8 5;fontFamily=Arial;fontSize=19;fontColor=#101820;align=left;verticalAlign=top;spacingTop=14;spacingLeft=16;spacingRight=12;" vertex="1" parent="core">
          <mxGeometry as="geometry" x="695" y="375" width="565" height="230" />
        </mxCell>
        <mxCell id="vnet" value="&lt;div style=&quot;font-size:18px;font-weight:bold;line-height:32px&quot;&gt;CUSTOMER VNET • core subscription + region • network boundary&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f9fc;strokeColor=#0078d4;dashed=1;dashPattern=8 5;fontFamily=Arial;fontSize=19;fontColor=#101820;align=left;verticalAlign=top;spacingTop=14;spacingLeft=16;spacingRight=12;container=1;collapsible=0;recursiveResize=0;pointerEvents=0;" vertex="1" parent="core">
          <mxGeometry as="geometry" x="25" y="660" width="1235" height="300" />
        </mxCell>
        <mxCell id="apim-subnet" value="&lt;div style=&quot;font-size:21px;font-weight:bold;line-height:32px&quot;&gt;APIM outbound subnet&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:27px&quot;&gt;Microsoft.Web/serverFarms delegation&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:27px&quot;&gt;Required NSG • approved routes / UDR&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:27px&quot;&gt;APIM compute is NOT in this subnet&lt;/div&gt;&lt;div style=&quot;font-size:19px;line-height:27px&quot;&gt;Existing APIM is not auto-attached&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:27px&quot;&gt;Actual caller VNet must resolve / route&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0078d4;dashed=1;dashPattern=8 5;fontFamily=Arial;fontSize=19;fontColor=#101820;align=left;verticalAlign=top;spacingTop=14;spacingLeft=16;spacingRight=12;" vertex="1" parent="vnet">
          <mxGeometry as="geometry" x="25" y="70" width="330" height="185" />
        </mxCell>
        <mxCell id="functions-subnet" value="&lt;div style=&quot;font-size:21px;font-weight:bold;line-height:32px&quot;&gt;Functions outbound subnet&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:27px&quot;&gt;Microsoft.App/environments delegation&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:27px&quot;&gt;Resolver + sync + optional reconciler&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:27px&quot;&gt;Flex compute is NOT in this subnet&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:27px&quot;&gt;Outbound integration ≠ inbound PE&lt;/div&gt;&lt;div style=&quot;font-size:19px;line-height:27px&quot;&gt;Separate from APIM subnet&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0078d4;dashed=1;dashPattern=8 5;fontFamily=Arial;fontSize=19;fontColor=#101820;align=left;verticalAlign=top;spacingTop=14;spacingLeft=16;spacingRight=12;" vertex="1" parent="vnet">
          <mxGeometry as="geometry" x="380" y="70" width="330" height="185" />
        </mxCell>
        <mxCell id="pe-subnet" value="&lt;div style=&quot;font-size:21px;font-weight:bold;line-height:32px&quot;&gt;PRIVATE-ENDPOINT SUBNET • NICs only&lt;/div&gt;&lt;div style=&quot;font-size:19px;line-height:27px&quot;&gt;Baseline: Cosmos SQL + each app&amp;#x27;s blob PE&lt;/div&gt;&lt;div style=&quot;font-size:19px;line-height:27px&quot;&gt;Optional: resolver sites PE (inbound only)&lt;/div&gt;&lt;div style=&quot;font-size:19px;line-height:27px&quot;&gt;Optional: Foundry account PE(s), any subscription&lt;/div&gt;&lt;div style=&quot;font-size:19px;line-height:27px&quot;&gt;PE approval and DNS / route must be verified&lt;/div&gt;&lt;div style=&quot;font-size:19px;line-height:27px&quot;&gt;Target PaaS services remain outside this VNet&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0078d4;dashed=1;dashPattern=8 5;fontFamily=Arial;fontSize=19;fontColor=#101820;align=left;verticalAlign=top;spacingTop=14;spacingLeft=16;spacingRight=12;" vertex="1" parent="vnet">
          <mxGeometry as="geometry" x="735" y="70" width="475" height="185" />
        </mxCell>
        <mxCell id="reconciler" value="&lt;div style=&quot;font-size:21px;font-weight:bold;line-height:32px&quot;&gt;OPTIONAL RECONCILER • Flex / UAMI&lt;/div&gt;&lt;div style=&quot;font-size:19px;line-height:27px&quot;&gt;LAW usage → budgetState / aggregateBudgetState&lt;/div&gt;&lt;div style=&quot;font-size:19px;line-height:27px&quot;&gt;Monetary mode only; baseline has no reconciler timer&lt;/div&gt;&lt;div style=&quot;font-size:19px;line-height:27px&quot;&gt;FunctionAppLogs diagnostics • reconcilerLease&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8ed;strokeColor=#ca5010;dashed=1;dashPattern=8 5;fontFamily=Arial;fontSize=19;fontColor=#101820;align=left;verticalAlign=top;spacingTop=14;spacingLeft=16;spacingRight=12;" vertex="1" parent="core">
          <mxGeometry as="geometry" x="25" y="1000" width="540" height="125" />
        </mxCell>
        <mxCell id="storage" value="&lt;div style=&quot;font-size:21px;font-weight:bold;line-height:32px&quot;&gt;PER-APP BLOB DEPLOYMENT STORAGE • outside VNet&lt;/div&gt;&lt;div style=&quot;font-size:19px;line-height:27px&quot;&gt;Resolver / sync / optional reconciler • identity-based access&lt;/div&gt;&lt;div style=&quot;font-size:19px;line-height:27px&quot;&gt;Public access disabled; shared-key auth off at creation&lt;/div&gt;&lt;div style=&quot;font-size:19px;line-height:27px&quot;&gt;Separate blob private endpoint per app • OneDeploy packages&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f2fc;strokeColor=#0078d4;dashed=0;dashPattern=8 5;fontFamily=Arial;fontSize=19;fontColor=#101820;align=left;verticalAlign=top;spacingTop=14;spacingLeft=16;spacingRight=12;" vertex="1" parent="core">
          <mxGeometry as="geometry" x="615" y="1000" width="645" height="125" />
        </mxCell>
        <mxCell id="backends" value="&lt;div style=&quot;font-size:18px;font-weight:bold;line-height:32px&quot;&gt;DESIGNATED BACKEND SUBSCRIPTION A • same tenant&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#687787;dashed=1;dashPattern=8 5;fontFamily=Arial;fontSize=19;fontColor=#101820;align=left;verticalAlign=top;spacingTop=14;spacingLeft=16;spacingRight=12;container=1;collapsible=0;recursiveResize=0;pointerEvents=0;" vertex="1" parent="tenant">
          <mxGeometry as="geometry" x="1360" y="335" width="615" height="450" />
        </mxCell>
        <mxCell id="foundry" value="&lt;div style=&quot;font-size:21px;font-weight:bold;line-height:32px&quot;&gt;PROJECT-SPECIFIC FOUNDRY ACCOUNT&lt;/div&gt;&lt;div style=&quot;font-size:19px;line-height:27px&quot;&gt;④ set-backend-service → resolved backendId only&lt;/div&gt;&lt;div style=&quot;font-size:19px;line-height:27px&quot;&gt;APIM system MI → cognitive resource token&lt;/div&gt;&lt;div style=&quot;font-size:19px;line-height:27px&quot;&gt;Cognitive Services User grant on each target account&lt;/div&gt;&lt;div style=&quot;font-size:19px;line-height:27px&quot;&gt;Accounts can live in different Azure subscriptions&lt;/div&gt;&lt;div style=&quot;font-size:19px;line-height:27px&quot;&gt;Anthropic account base: /anthropic&lt;/div&gt;&lt;div style=&quot;font-size:19px;line-height:27px&quot;&gt;Messages: /v1/messages • NOT /api/projects&lt;/div&gt;&lt;div style=&quot;font-size:19px;line-height:27px&quot;&gt;Public/private exposure is backend-owner policy&lt;/div&gt;&lt;div style=&quot;font-size:19px;line-height:27px&quot;&gt;Optional PEs are in caller&amp;#x27;s VNet, not here&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f2fc;strokeColor=#0078d4;dashed=0;dashPattern=8 5;fontFamily=Arial;fontSize=19;fontColor=#101820;align=left;verticalAlign=top;spacingTop=14;spacingLeft=16;spacingRight=12;" vertex="1" parent="backends">
