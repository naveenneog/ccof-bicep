  <diagram id="ccof-network-architecture" name="Network and trust overview">
    <mxGraphModel dx="2500" dy="2160" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2500" pageHeight="2400" math="0" shadow="0">
      <root>
