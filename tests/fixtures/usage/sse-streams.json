{
  "_readme": "Anthropic Messages server-sent event streams for tests/usage-sse.test.ts (O10, ADR-0022). Event shapes follow Anthropic 'Streaming messages' and 'Prompt caching' (retrieved 2026-10-12). Every text is synthetic. The u-c and u-d streams carry the usage that WP-GW recorded for calls U-C and U-D on 2026-10-12 (docs/status/WP-GW.md, 'U-34, the counters and the person quota'): message_start held all five counts with the TTL split, and message_delta repeated input, output and both cache totals without the split. Expected values use the rate card's five category names; null means not reported, never zero.",
  "streams": [
    {
      "name": "u-c-recorded",
      "source": "WP-GW U-C, streamed, same prefix (cache read); counts as recorded, text synthetic",
      "events": [
        ["message_start", { "type": "message_start", "message": { "id": "msg_fixture_uc", "type": "message", "role": "assistant", "content": [], "model": "claude-haiku-4-5-20251001", "stop_reason": null, "stop_sequence": null, "usage": { "input_tokens": 13, "cache_creation_input_tokens": 0, "cache_read_input_tokens": 5890, "cache_creation": { "ephemeral_5m_input_tokens": 0, "ephemeral_1h_input_tokens": 0 }, "output_tokens": 1 } } }],
        ["content_block_start", { "type": "content_block_start", "index": 0, "content_block": { "type": "text", "text": "" } }],
        ["ping", { "type": "ping" }],
        ["content_block_delta", { "type": "content_block_delta", "index": 0, "delta": { "type": "text_delta", "text": "SENTINEL-TEXT ok" } }],
        ["content_block_stop", { "type": "content_block_stop", "index": 0 }],
        ["message_delta", { "type": "message_delta", "delta": { "stop_reason": "end_turn", "stop_sequence": null }, "usage": { "input_tokens": 13, "cache_creation_input_tokens": 0, "cache_read_input_tokens": 5890, "output_tokens": 4 } }],
        ["message_stop", { "type": "message_stop" }]
      ],
      "expected": { "outcome": "complete", "final": true, "ttlSplitMismatch": false, "tokens": { "input": 13, "cacheWrite5m": 0, "cacheWrite1h": 0, "cacheRead": 5890, "output": 4 } }
    },
    {
      "name": "u-d-recorded",
      "source": "WP-GW U-D, streamed, new prefix (5-minute cache write); counts as recorded, text synthetic",
      "events": [
        ["message_start", { "type": "message_start", "message": { "id": "msg_fixture_ud", "type": "message", "role": "assistant", "content": [], "model": "claude-haiku-4-5-20251001", "stop_reason": null, "stop_sequence": null, "usage": { "input_tokens": 13, "cache_creation_input_tokens": 6650, "cache_read_input_tokens": 0, "cache_creation": { "ephemeral_5m_input_tokens": 6650, "ephemeral_1h_input_tokens": 0 }, "output_tokens": 1 } } }],
        ["content_block_start", { "type": "content_block_start", "index": 0, "content_block": { "type": "text", "text": "" } }],
        ["content_block_delta", { "type": "content_block_delta", "index": 0, "delta": { "type": "text_delta", "text": "SENTINEL-TEXT ok \u20ac \ud83d\ude00" } }],
        ["content_block_stop", { "type": "content_block_stop", "index": 0 }],
        ["message_delta", { "type": "message_delta", "delta": { "stop_reason": "end_turn", "stop_sequence": null }, "usage": { "input_tokens": 13, "cache_creation_input_tokens": 6650, "cache_read_input_tokens": 0, "output_tokens": 4 } }],
        ["message_stop", { "type": "message_stop" }]
      ],
      "expected": { "outcome": "complete", "final": true, "ttlSplitMismatch": false, "tokens": { "input": 13, "cacheWrite5m": 6650, "cacheWrite1h": 0, "cacheRead": 0, "output": 4 } }
    },
