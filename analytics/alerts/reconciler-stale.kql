AppLogs
| where Message has "ccof.reconciler.run.v1"
| extend d = parse_json(Message)
| where tostring(d.schema) == "ccof.reconciler.run.v1" and tostring(d.outcome) == "written"
| summarize lastWritten = max(TimeGenerated)
| project value = iff(isnull(lastWritten), toreal(_windowMinutes), toreal(datetime_diff("minute", now(), lastWritten)))
