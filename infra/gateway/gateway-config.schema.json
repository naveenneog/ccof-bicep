{
  "$comment": "Schema for the gateway policy configuration (infra/gateway/config/*.json). infra/gateway/config.ts interprets this file; it supports only the keywords listed in infra/gateway/json-schema.ts and refuses any other, so the schema cannot silently rely on an unsupported feature. Every value is required: there are no defaults. Patterns exclude quotes, angle brackets, ampersands, braces and '@', so a value can be placed in an XML attribute, XML text or a C# string literal without escaping.",
  "title": "claude-code-on-foundry gateway configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "configurationId", "apim", "entra", "admission", "resolver", "entitlementCache", "tokenLimits", "backends", "inferenceGeo", "forwarding"],
  "properties": {
    "$schema": { "type": "string", "maxLength": 200 },
    "schemaVersion": { "const": 1 },
    "configurationId": { "$ref": "#/$defs/name", "description": "The administrator's identifier for this reviewed configuration; it is stamped into the rendered policy and the revision description." },
    "apim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subscriptionId", "resourceGroup", "serviceName", "apiId", "gatewayBaseUrl", "apiPath"],
      "properties": {
        "subscriptionId": { "$ref": "#/$defs/guid" },
        "resourceGroup": { "type": "string", "pattern": "^[A-Za-z0-9._()-]{1,90}$" },
        "serviceName": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9-]{0,49}$" },
        "apiId": { "$ref": "#/$defs/name" },
        "gatewayBaseUrl": { "$ref": "#/$defs/httpsOrigin" },
        "apiPath": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$" }
      }
    },
    "entra": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenantId", "authorityHost", "v1IssuerHost", "audiences", "delegatedScope", "delegatedClientAppIds", "testIdentities"],
      "properties": {
        "tenantId": { "$ref": "#/$defs/guid" },
        "authorityHost": { "$ref": "#/$defs/httpsOrigin", "description": "Entra authority, for the v2 issuer and the OpenID configuration." },
        "v1IssuerHost": { "$ref": "#/$defs/httpsOrigin", "description": "Host of the v1 token issuer (https://<host>/<tenant>/)." },
        "audiences": { "type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true, "items": { "$ref": "#/$defs/audience" } },
        "delegatedScope": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,120}$", "description": "The scope a person's (delegated) token must carry in scp." },
        "delegatedClientAppIds": { "type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": { "$ref": "#/$defs/guid" }, "description": "The client applications a person's token may come from (azp, or appid in a v1 token): the developer sign-in app. WP-SEC A3." },
        "testIdentities": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allowAppOnlyTokens", "clientAppIds", "appRole"],
          "properties": {
            "allowAppOnlyTokens": { "type": "boolean", "description": "true admits app-only tokens, only from clientAppIds and only with appRole in roles; false refuses every app-only token." },
            "clientAppIds": { "type": "array", "maxItems": 20, "uniqueItems": true, "items": { "$ref": "#/$defs/guid" } },
            "appRole": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$", "description": "The app role an app-only token must carry in its roles claim (exact match; WP-NET S1). null when allowAppOnlyTokens is false." }
          }
        }
      }
    },
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["perPerson", "resolverMisses"],
      "properties": {
        "perPerson": {
          "type": "object",
          "additionalProperties": false,
          "required": ["calls", "renewalPeriodSeconds"],
          "properties": {
            "calls": { "type": "integer", "minimum": 1, "maximum": 1000000 },
            "renewalPeriodSeconds": { "type": "integer", "minimum": 1, "maximum": 300, "description": "rate-limit-by-key allows at most 300 seconds (Microsoft Learn)." }
          }
        },
        "resolverMisses": {
          "type": "object",
          "additionalProperties": false,
          "required": ["calls", "renewalPeriodSeconds", "maxConcurrent"],
          "properties": {
            "calls": { "type": "integer", "minimum": 1, "maximum": 1000000 },
            "renewalPeriodSeconds": { "type": "integer", "minimum": 1, "maximum": 300 },
            "maxConcurrent": { "type": "integer", "minimum": 1, "maximum": 100000 }
          }
        }
      }
    },
    "resolver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "tokenAudience", "timeoutSeconds", "projectHeaderName"],
      "properties": {
        "url": { "$ref": "#/$defs/httpsUrl" },
        "tokenAudience": { "$ref": "#/$defs/audience", "description": "The resource APIM's managed identity requests a token for (ADR-0009: the resolver app registration's application id)." },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 60 },
        "projectHeaderName": { "$ref": "#/$defs/headerName", "description": "The request header that selects one of the person's projects (C-1, ADR-0006)." }
      }
    },
    "entitlementCache": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyVersion", "cachingType", "allowTtlSeconds", "refusalTtlSeconds", "lastKnownGoodGraceSeconds", "refreshBackoffSeconds", "unavailableRetryAfterSeconds"],
      "properties": {
        "keyVersion": { "type": "integer", "minimum": 1, "maximum": 999999, "description": "Part of every cache key; raising it makes every cached decision a miss." },
        "cachingType": { "enum": ["internal", "external", "prefer-external"] },
        "allowTtlSeconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
        "refusalTtlSeconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
        "lastKnownGoodGraceSeconds": { "type": "integer", "minimum": 0, "maximum": 604800, "description": "How long after allowTtlSeconds an allow may still be served, marked degraded, while the resolver fails. 0 disables last-known-good serving." },
        "refreshBackoffSeconds": { "type": "integer", "minimum": 1, "maximum": 3600, "description": "After a refresh of an expired allow fails, how long last-known-good is served without asking the resolver again. At most lastKnownGoodGraceSeconds when that is above 0." },
        "unavailableRetryAfterSeconds": { "type": "integer", "minimum": 1, "maximum": 3600 }
      }
    },
    "tokenLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["estimatePromptTokens", "headers"],
      "properties": {
        "estimatePromptTokens": { "type": "boolean" },
        "headers": {
          "type": "object",
          "additionalProperties": false,
          "required": ["personRemainingQuota", "personRemainingTokens", "groupRemainingQuota", "groupRemainingTokens", "tokensConsumed"],
          "properties": {
            "personRemainingQuota": { "$ref": "#/$defs/headerName" },
            "personRemainingTokens": { "$ref": "#/$defs/headerName" },
            "groupRemainingQuota": { "$ref": "#/$defs/headerName" },
            "groupRemainingTokens": { "$ref": "#/$defs/headerName" },
            "tokensConsumed": { "$ref": "#/$defs/headerName" }
          }
        }
      }
    },
    "backends": {
      "type": "array",
      "description": "Static backends: those whose credential needs a secret named value in the policy (cross-tenant client credentials, the fallback while credential manager is unproven, U-43). Adding one changes the policy. Every other backend comes by data: the resolver's backend descriptor (C-8); the gateway routes only to what the resolver returns.",
      "minItems": 0,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "credential"],
        "properties": {
          "id": { "$ref": "#/$defs/name", "description": "An APIM backend entity name." },
          "credential": { "$ref": "#/$defs/crossTenantClientCredentials" }
        }
      }
    },
    "inferenceGeo": {
      "type": "object",
      "description": "Registered deployment type per backend id and deployment name, for the usage trace's inferenceGeo (docs/TELEMETRY.md). Optional per backend: a deployment not listed is reported as unknown.",
      "propertyNames": { "$ref": "#/$defs/name" },
      "additionalProperties": {
        "type": "object",
        "propertyNames": { "$ref": "#/$defs/modelName" },
        "additionalProperties": { "enum": ["global", "us"] }
      }
    },
    "forwarding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defaultAnthropicVersion"],
      "properties": {
        "defaultAnthropicVersion": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "description": "Sent when the client sends no anthropic-version header; null sends none." }
      }
    }
  },
  "$defs": {
    "guid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$" },
    "modelName": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$" },
    "headerName": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9-]{0,63}$" },
    "httpsOrigin": { "type": "string", "pattern": "^https://[a-z0-9-]+(\\.[a-z0-9-]+)+$" },
    "httpsUrl": { "type": "string", "pattern": "^https://[a-z0-9-]+(\\.[a-z0-9-]+)+(/[A-Za-z0-9._~-]+)*/?$" },
    "audience": { "type": "string", "pattern": "^([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}|api://[A-Za-z0-9._~-]+(/[A-Za-z0-9._~-]+)*|https://[a-z0-9-]+(\\.[a-z0-9-]+)+(/[A-Za-z0-9._~-]+)*/?)$" },
    "crossTenantClientCredentials": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "tenantId", "clientId", "clientSecretNamedValue", "authorityHost", "scope", "tokenRequestTimeoutSeconds"],
      "properties": {
        "type": { "const": "crossTenantClientCredentials" },
        "tenantId": { "$ref": "#/$defs/guid" },
        "clientId": { "$ref": "#/$defs/guid" },
        "clientSecretNamedValue": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,256}$", "description": "Name of the APIM secret named value that holds the client secret; the secret itself is never in configuration." },
        "authorityHost": { "$ref": "#/$defs/httpsOrigin" },
        "scope": { "$ref": "#/$defs/httpsUrl" },
        "tokenRequestTimeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 60 }
      }
    }
  }
}
